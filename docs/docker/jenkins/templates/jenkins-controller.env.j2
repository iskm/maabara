# Managed by Ansible. Changes will be overwritten.
JAVA_OPTS={% if jenkins_controller_ca_mode in ['runtime', 'both'] %}-Djavax.net.ssl.trustStore=/run/jenkins/tls/truststore.jks -Djavax.net.ssl.trustStorePassword={{ jenkins_controller_keystore_password }} {% endif %}{{ jenkins_controller_java_opts_extra }}
JENKINS_OPTS=--httpPort=-1 --httpsPort={{ jenkins_controller_container_port }} --httpsKeyStore=/run/jenkins/tls/server.p12 --httpsKeyStorePassword={{ jenkins_controller_keystore_password }}
{% if jenkins_controller_ca_mode in ['runtime', 'both'] %}
SSL_CERT_FILE={{ jenkins_controller_container_os_ca_bundle_path }}
CURL_CA_BUNDLE={{ jenkins_controller_container_os_ca_bundle_path }}
GIT_SSL_CAINFO={{ jenkins_controller_container_os_ca_bundle_path }}
REQUESTS_CA_BUNDLE={{ jenkins_controller_container_os_ca_bundle_path }}
NODE_EXTRA_CA_CERTS={{ jenkins_controller_container_os_ca_bundle_path }}
{% endif %}
{% if jenkins_controller_jcasc_file | length > 0 %}
CASC_JENKINS_CONFIG=/var/jenkins_home/jenkins.yaml
{% endif %}
{% for environment_name, environment_value in jenkins_controller_extra_environment | dictsort %}
{{ environment_name }}={{ environment_value }}
{% endfor %}
