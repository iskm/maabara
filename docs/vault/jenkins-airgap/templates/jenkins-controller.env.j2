# Managed by Ansible. Changes will be overwritten.
JAVA_OPTS=-Djavax.net.ssl.trustStore=/run/jenkins/tls/truststore.jks -Djavax.net.ssl.trustStorePassword={{ jenkins_controller_keystore_password }} {{ jenkins_controller_java_opts_extra }}
JENKINS_OPTS=--httpPort=-1 --httpsPort={{ jenkins_controller_container_port }} --httpsKeyStore=/run/jenkins/tls/server.p12 --httpsKeyStorePassword={{ jenkins_controller_keystore_password }}
SSL_CERT_FILE=/run/jenkins/tls/ca-bundle.pem
CURL_CA_BUNDLE=/run/jenkins/tls/ca-bundle.pem
GIT_SSL_CAINFO=/run/jenkins/tls/ca-bundle.pem
REQUESTS_CA_BUNDLE=/run/jenkins/tls/ca-bundle.pem
NODE_EXTRA_CA_CERTS=/run/jenkins/tls/ca-bundle.pem
{% if jenkins_controller_jcasc_file | length > 0 %}
CASC_JENKINS_CONFIG=/var/jenkins_home/jenkins.yaml
{% endif %}
{% for environment_name, environment_value in jenkins_controller_extra_environment | dictsort %}
{{ environment_name }}={{ environment_value }}
{% endfor %}
